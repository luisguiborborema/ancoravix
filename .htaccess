# Ancoravix — configuração Apache (hospedagem compartilhada / cPanel)

# ---------- Codificação (acentos corretos em .txt, llms.txt, sitemap) ----------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .txt .xml .json

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Unifica www -> sem www (mesmo domínio da tag canonical)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Remove "index.html" da URL
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Site antigo em /site/ -> nova página (301 preserva o ranqueamento).
  # ATIVE SOMENTE depois de publicar o novo site e desativar o WordPress em /site/.
  # RewriteRule ^site(/.*)?$ / [L,R=301]
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Cache do navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

# ---------- Segurança básica ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
